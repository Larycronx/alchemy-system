<section class="alchemy-shell alchemy-admin">
  <header class="alchemy-hero"><img src="modules/alchemy-system/assets/alchemy.svg" alt=""/><div><h1>{{localize "ALCHEMY.GM.Title"}}</h1><p>{{localize "ALCHEMY.GM.Subtitle"}}</p></div><div class="header-actions"><button type="button" data-action="exportData"><i class="fa-solid fa-file-export"></i> {{localize "ALCHEMY.Actions.Export"}}</button><button type="button" data-action="importData"><i class="fa-solid fa-file-import"></i> {{localize "ALCHEMY.Actions.Import"}}</button><input data-import-file type="file" accept="application/json,.json" hidden /></div></header>
  <main class="alchemy-admin-grid alchemy-scroll">
    <section class="admin-recipes"><header><h2>{{localize "ALCHEMY.GM.Library"}}</h2><button type="button" data-action="newRecipe"><i class="fa-solid fa-plus"></i> {{localize "ALCHEMY.GM.NewRecipe"}}</button></header>
      <div class="admin-recipe-list">{{#each recipes}}<article><img src="{{img}}" alt=""/><div><strong>{{name}}</strong><small>{{type}} · {{category}} · CD {{check.dc}}</small></div><button type="button" data-action="editRecipe" data-recipe-id="{{id}}" title="{{localize 'ALCHEMY.Actions.Edit'}}"><i class="fa-solid fa-pen"></i></button><button type="button" data-action="duplicateRecipe" data-recipe-id="{{id}}" title="{{localize 'ALCHEMY.Actions.Duplicate'}}"><i class="fa-solid fa-copy"></i></button><button class="danger" type="button" data-action="deleteRecipe" data-recipe-id="{{id}}" title="{{localize 'ALCHEMY.Actions.Delete'}}"><i class="fa-solid fa-trash"></i></button></article>{{/each}}</div>
      <button type="button" data-action="resetExamples"><i class="fa-solid fa-arrow-rotate-left"></i> {{localize "ALCHEMY.GM.ResetExamples"}}</button>
    </section>

    <section class="admin-editor"><h2>{{localize "ALCHEMY.GM.Editor"}}</h2>
      {{#if editing}}<form data-recipe-editor>
        <div class="form-grid"><label>{{localize "ALCHEMY.Fields.Name"}}<input name="name" required value="{{editing.name}}" /></label><label>{{localize "ALCHEMY.Fields.Type"}}<select name="type">{{selectOptions typeChoices selected=editing.type}}</select></label><label>{{localize "ALCHEMY.Fields.Category"}}<input name="category" value="{{editing.category}}" /></label><label>{{localize "ALCHEMY.Fields.Rarity"}}<input name="rarity" value="{{editing.rarity}}" /></label><label class="wide">{{localize "ALCHEMY.Fields.Image"}}<input name="img" value="{{editing.img}}" /></label><label class="wide">{{localize "ALCHEMY.Fields.Description"}}<textarea name="description">{{editing.description}}</textarea></label>
          <label class="wide">{{localize "ALCHEMY.Fields.Ingredients"}}<textarea name="ingredients" required placeholder="1|Erva Vermelha&#10;1|Água Purificada&#10;ou 1|@cura+natural">{{editing.ingredientsEditor}}</textarea><small>{{localize "ALCHEMY.GM.IngredientSyntax"}}</small></label>
          <label>{{localize "ALCHEMY.Fields.ResultName"}}<input name="resultName" value="{{editing.result.name}}" /></label><label>{{localize "ALCHEMY.Fields.ResultType"}}<input name="resultType" value="{{editing.result.type}}" /></label><label>{{localize "ALCHEMY.Fields.Quantity"}}<input name="resultQuantity" type="number" min="1" value="{{editing.result.quantity}}" /></label><label>{{localize "ALCHEMY.Fields.Formula"}}<input name="formula" value="{{editing.result.formula}}" /></label><label class="wide">{{localize "ALCHEMY.Fields.ResultDescription"}}<textarea name="resultDescription">{{editing.result.description}}</textarea></label>
          <label>{{localize "ALCHEMY.Fields.CheckType"}}<select name="checkType">{{selectOptions checkTypeChoices selected=editing.check.type}}</select></label><label>{{localize "ALCHEMY.Fields.CheckKey"}}<input name="checkKey" value="{{editing.check.key}}" /></label><label>{{localize "ALCHEMY.Fields.DC"}}<input name="dc" type="number" min="1" max="40" value="{{editing.check.dc}}" /></label><label>{{localize "ALCHEMY.Fields.CheckFormula"}}<input name="checkFormula" value="{{editing.check.formula}}" /></label>
          <label class="wide">{{localize "ALCHEMY.Fields.Tags"}}<input name="tags" value="{{editing.tagsEditor}}" /></label><label class="wide">{{localize "ALCHEMY.Fields.Equipment"}}<input name="equipment" value="{{editing.equipmentEditor}}" /></label><label>{{localize "ALCHEMY.Fields.Time"}}<input name="craftingTime" type="number" min="0" value="{{editing.craftingTime}}" /></label>
        </div><div class="check-row"><label><input type="checkbox" name="checkEnabled" {{checked editing.check.enabled}} /> {{localize "ALCHEMY.Fields.CheckEnabled"}}</label><label><input type="checkbox" name="discoverable" {{checked editing.discoverable}} /> {{localize "ALCHEMY.Fields.Discoverable"}}</label><label><input type="checkbox" name="secret" {{checked editing.secret}} /> {{localize "ALCHEMY.Fields.Secret"}}</label></div><button type="button" data-action="saveRecipe"><i class="fa-solid fa-floppy-disk"></i> {{localize "ALCHEMY.Actions.Save"}}</button>
      </form>{{else}}<p>{{localize "ALCHEMY.GM.SelectRecipe"}}</p>{{/if}}
    </section>

    <section class="admin-knowledge"><h2>{{localize "ALCHEMY.GM.Knowledge"}}</h2><select data-actor-select><option value="">{{localize "ALCHEMY.GM.SelectActor"}}</option>{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{#if selectedActor}}<div class="admin-maintenance"><button type="button" data-action="clearKnowledge" class="danger"><i class="fa-solid fa-book-skull"></i> {{localize "ALCHEMY.GM.ClearKnowledge"}}</button><button type="button" data-action="clearHistory" class="danger"><i class="fa-solid fa-trash-can"></i> {{localize "ALCHEMY.GM.ClearHistory"}}</button><button type="button" data-action="resetProgression" class="danger"><i class="fa-solid fa-arrow-rotate-left"></i> {{localize "ALCHEMY.GM.ResetProgression"}}</button></div><div class="knowledge-list">{{#each knowledgeRecipes}}<div class="knowledge-row"><label><input type="checkbox" name="knowledge" value="{{id}}" {{#if checked}}checked{{/if}}/> {{name}}</label>{{#if checked}}<button type="button" data-action="revokeKnowledge" data-recipe-id="{{id}}" class="icon-button danger" title="{{localize 'ALCHEMY.GM.RevokeKnowledge'}}"><i class="fa-solid fa-book-minus"></i></button>{{/if}}</div>{{/each}}</div><button type="button" data-action="saveKnowledge"><i class="fa-solid fa-book"></i> {{localize "ALCHEMY.GM.SaveKnowledge"}}</button>{{#if actorNotes}}<details><summary>{{localize "ALCHEMY.GM.ActorNotes"}}</summary><p>{{actorNotes}}</p></details>{{/if}}{{/if}}</section>

    <section class="admin-logs"><h2>{{localize "ALCHEMY.GM.Logs"}}</h2><div class="history-list">{{#each logs}}<article class="history-entry {{#if success}}success{{else}}failure{{/if}}"><time>{{date}}</time><h3>{{actorName}} — {{recipeName}}</h3><p>{{userName}} · {{result}}{{#if check.total}} · {{check.total}}{{/if}}</p><p>{{#each ingredients}}{{quantity}}× {{name}}{{#unless @last}}, {{/unless}}{{/each}}</p></article>{{else}}<p>{{localize "ALCHEMY.GM.NoLogs"}}</p>{{/each}}</div></section>
  </main>
</section>
